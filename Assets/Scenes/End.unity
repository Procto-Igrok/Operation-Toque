      m_Calls: []
  m_text: "\u041C\u044B \u043F\u043B\u0430\u043D\u0438\u0440\u0443\u0435\u043C \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438
    \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u044F \u0434\u0430\u043D\u043D\u043E\u0439
    \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0438, \u0447\u0442\u043E\u0431\u044B
    \u0443\u0431\u0435\u0434\u0438\u0442\u044C\u0441\u044F, \u0447\u0442\u043E \u043E\u043D\u0430
    \u0434\u0430\u0441\u0442 \u043D\u0430\u043C \u0437\u0430\u044F\u0432\u043B\u0435\u043D\u043D\u044B\u0435
    \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u044F. \u0415\u0441\u043B\u0438 \u0432\u0441\u0435
    \u043F\u0440\u043E\u0439\u0434\u0435\u0442 \u0445\u043E\u0440\u043E\u0448\u043E,
    \u0442\u043E \u043C\u044B \u043D\u0430\u0447\u043D\u0435\u043C \u0432\u043D\u0435\u0434\u0440\u044F\u0442\u044C
    \u044D\u0442\u0438 \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0438
    \u0432 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u0441\u0442\u0430\u043D\u0446\u0438\u0438."
